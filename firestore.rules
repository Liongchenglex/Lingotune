rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for cleaner rules
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all by default (fail closed)
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile data - users can only access their own data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      // Prevent accidental deletion - uncomment if needed
      // allow delete: if isOwner(userId);

      // User's private subcollections (e.g., settings, preferences)
      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // User learning progress - scoped to authenticated user
    match /progress/{userId} {
      allow read, write: if isOwner(userId);

      // Lessons progress subcollection
      match /lessons/{lessonId} {
        allow read, write: if isOwner(userId);
      }

      // Vocabulary progress subcollection
      match /vocabulary/{vocabId} {
        allow read, write: if isOwner(userId);
      }
    }

    // User achievements - read/write for owner only
    match /achievements/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Public content (lessons, courses) - read-only for authenticated users
    // Only admins should write (enforce via Firebase Console or Admin SDK)
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if false; // Use Admin SDK for writes
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if false; // Use Admin SDK for writes
    }

    match /vocabulary/{vocabId} {
      allow read: if isAuthenticated();
      allow write: if false; // Use Admin SDK for writes
    }

    // User-generated content (e.g., notes, bookmarks)
    match /notes/{noteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Leaderboards - read for authenticated, no direct writes (use Cloud Functions)
    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if false; // Use Cloud Functions for updates
    }

    // ===== MUSIC FEATURE =====

    // Songs collection - song metadata and lyrics info
    // Users can read all songs, but can only write songs they add
    match /songs/{songId} {
      allow read: if isAuthenticated();
      // Allow users to create/update song entries
      // Songs are shared resources - any authenticated user can add them
      allow create, update: if isAuthenticated();
      allow delete: if false; // Never delete songs (shared resource)
    }

    // ===== ONBOARDING FEATURE =====

    // Question bank - read-only for authenticated users
    // Write via Admin SDK only (import script or Firebase Console)
    match /questionBank/{questionId} {
      allow read: if isAuthenticated();
      allow write: if false; // Use Admin SDK for writes
    }

    // Onboarding test results - users can only access their own test results
    match /onboardingTests/{testId} {
      // Read: Only the user who created the test
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Create: Only if userId matches authenticated user
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.profileStatus == 'pending';

      // Update: Blocked for clients (only Cloud Functions can update)
      // Cloud Functions run with admin privileges and bypass these rules
      allow update: if false;

      // Delete: Never allow (tests are immutable records)
      allow delete: if false;
    }
  }
}
