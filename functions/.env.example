# Firebase Functions Environment Variables
# Copy this file to .env.development and .env.production and fill in your actual API keys

# OpenAI API Key (for AI profile generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (for AI profile generation fallback)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
